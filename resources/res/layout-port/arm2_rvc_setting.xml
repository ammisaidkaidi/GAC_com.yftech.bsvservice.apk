<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/arm2_content_layout"
    android:background="#00000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/arm2_display_settings"
        android:layout_width="400dp"
        android:layout_height="200dp"
        android:layout_marginTop="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Hue:"/>
            <SeekBar
                android:id="@+id/arm2_sb_hue"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:max="127"
                android:progressBackgroundTint="#ffffff"
                android:min="-128"/>
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/arm2_tv_hue"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Brightness:"/>
            <SeekBar
                android:id="@+id/arm2_sb_brightness"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:max="127"
                android:progressBackgroundTint="#ffffff"
                android:min="-128"/>
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/arm2_tv_brightness"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="contrast:"/>
            <SeekBar
                android:id="@+id/arm2_sb_contrast"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:max="255"
                android:progressBackgroundTint="#ffffff"
                android:min="0"/>
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/arm2_tv_contrast"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Saturation:"/>
            <SeekBar
                android:id="@+id/arm2_sb_saturation"
                android:layout_width="280dp"
                android:layout_height="match_parent"
                android:max="255"
                android:progressBackgroundTint="#ffffff"
                android:min="0"/>
            <TextView
                android:textColor="#ffffff"
                android:layout_gravity="center_vertical"
                android:id="@+id/arm2_tv_saturation"
                android:layout_width="40dp"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
