<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/center_dividor"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="2dp"
        android:layout_marginRight="1px"
        android:layout_toLeftOf="@+id/center_dividor">
        <TextureView
            android:id="@+id/tv_front_camera"
            android:layout_width="match_parent"
            android:layout_height="400px"/>
        <LinearLayout
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_mic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strMicOn"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_watermark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/watermark_settings"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_record_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/record_settings"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_normal_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strStartRecord"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_urgent_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strUrgent"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_front_snapshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strSnapshot"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="1px"
        android:layout_marginTop="2dp"
        android:layout_toRightOf="@+id/center_dividor">
        <TextureView
            android:id="@+id/tv_back_camera"
            android:layout_width="match_parent"
            android:layout_height="400px"/>
        <LinearLayout
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_mic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strMicOn"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_watermark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/watermark_settings"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_record_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/record_settings"
                android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_normal_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strStartRecord"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_urgent_record"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strUrgent"
                android:layout_weight="1"/>
            <Button
                android:textSize="10sp"
                android:id="@+id/btn_back_snapshot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/strSnapshot"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <com.yftech.bsvservice.activity.WatermarkSettingsView
        android:id="@+id/front_watermark_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"/>
    <com.yftech.bsvservice.activity.WatermarkSettingsView
        android:id="@+id/back_watermark_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"/>
    <com.yftech.bsvservice.activity.RecordSettingsView
        android:id="@+id/front_record_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"/>
    <com.yftech.bsvservice.activity.RecordSettingsView
        android:id="@+id/back_record_settings"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
